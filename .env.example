# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for privileged operations (e.g. server-side repositories).
# Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=
# Overridable so we can roll models without a code change.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Stripe (billing) ---------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional. Without this set, /api/stripe/checkout falls back to inline
# price_data using the constants in lib/billing/plan.ts — a pre-created
# Price is the better long-term setup (needed for Stripe's customer portal),
# but isn't required to start testing checkout.
STRIPE_PRICE_ID=

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Fred Invoice (Snabbfaktura iframe integration) ---------------------------
# Base URL of the Snabbfaktura app, proxied same-origin via
# /api/invoice-proxy so its session survives third-party-cookie blocking.
# If unset, /core/invoice renders a "Coming soon" card instead of the iframe.
NEXT_PUBLIC_SNABBFAKTURA_URL=https://snabbfaktura.vercel.app

# --- Fred Core hub apps (lib/core-apps/registry.ts) ----------------------------
# Base URLs for the remaining /core/[appName] iframe embeds. These are
# embedded directly (no proxy) since each app allows framing from our
# origin (verified CSP frame-ancestors / no X-Frame-Options). Any unset
# var renders a "Coming soon" card for that app instead of the iframe.
NEXT_PUBLIC_FREDRADAR_URL=https://fred-radar.vercel.app
NEXT_PUBLIC_FREDCAST_URL=https://fred-cast.vercel.app
NEXT_PUBLIC_GATEZERO_URL=https://gatezero-inky.vercel.app
NEXT_PUBLIC_PROMPTSLAKTAREN_URL=https://promptslaktaren.vercel.app
NEXT_PUBLIC_DEBT_OPTIMIZER_URL=
